
# PrivateGPT systemd service
#
# Example configuration for a locally hosted,
# network-restricted cybersecurity RAG assistant.
#
# Replace "YOUR_USERNAME" and adjust installation
# paths before deploying.

[Unit]
Description=PrivateGPT - Offline Cybersecurity AI
After=ollama.service
Requires=ollama.service

[Service]
Type=simple

# Run as an unprivileged Linux user.
User=YOUR_USERNAME
Group=YOUR_USERNAME

# Local project directory.
WorkingDirectory=/home/YOUR_USERNAME/projects/offline-cyber-rag

# Application environment.
Environment="HOME=/home/YOUR_USERNAME"
Environment="PGPT_SETTINGS_FOLDER=/home/YOUR_USERNAME/.local/share/uv/tools/private-gpt/lib/python3.11/site-packages,/home/YOUR_USERNAME/.config/private-gpt"

# Bind the API to localhost only.
ExecStart=/home/YOUR_USERNAME/.local/bin/private-gpt serve --host 127.0.0.1 --port 8080

# Deny external IPv4 and IPv6 connections.
# Allow communication between local AI services.
IPAddressDeny=any
IPAddressAllow=localhost

# Automatically recover from application failures.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
